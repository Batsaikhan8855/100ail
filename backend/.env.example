DATABASE_URL="postgresql://user@localhost:5432/ail100?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
PUBLIC_API_URL="http://localhost:4000/api"
# Таслалаар тусгаарлана. Vercel-ийн preview домэйнд `https://*.vercel.app`
# гэсэн орлуулагч ажиллана (`*` нь цэггүй нэг хэсэгтэй тохирно).
CORS_ORIGINS="http://localhost:3100,http://localhost:3200,http://localhost:3300"
PLATFORM_COMMISSION_RATE=0.02

# Redis — cache болон BullMQ дараалал. Хоосон бол ажлууд шууд гүйцэтгэгдэнэ.
REDIS_URL=""

# Meilisearch — хоосон бол хайлт PostgreSQL дээр ажиллана.
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

# S3-той нийцтэй файл хадгалалт (барааны зураг, баримт)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="http://localhost:4000/media"

# Дотоод медиа сан (S3 тохируулаагүй үед барааны зургийг эндээс өгнө)
MEDIA_DIR="media"

# QPay merchant API — хоосон бол mock нэхэмжлэхээр ажиллана.
QPAY_BASE_URL="https://merchant.qpay.mn/v2"
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""

# Байршил (Google Maps/Mapbox). MAPBOX_TOKEN хоосон бол түлхүүр
# шаардахгүй OpenStreetMap (Nominatim) ашиглана.
MAPBOX_TOKEN=""
NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Мэдэгдлийг гадагш илгээх суваг. Хоосон бол мэдэгдэл зөвхөн апп дотор
# харагдана (DB-д хадгалагдана).
MAIL_WEBHOOK_URL=""
MAIL_WEBHOOK_TOKEN=""
MAIL_FROM="100 Айл <no-reply@100ail.mn>"
SMS_GATEWAY_URL=""
SMS_GATEWAY_TOKEN=""

# Мэдэгдэл дэх холбоос энэ хаягаас эхэлнэ (имэйл, SMS-д ашиглагдана)
PUBLIC_WEB_URL="http://localhost:3100"
