{
  "name": "barilgahub",
  "version": "0.1.0",
  "private": true,
  "description": "barilgaHUB — барилгын материалын e-commerce платформ (modular monolith)",
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:storefront": "npm --prefix frontend/storefront run dev",
    "dev:supplier": "npm --prefix frontend/supplier run dev",
    "dev:admin": "npm --prefix frontend/admin run dev",
    "build:backend": "npm --prefix backend run build",
    "build:storefront": "npm --prefix frontend/storefront run build",
    "build:supplier": "npm --prefix frontend/supplier run build",
    "build:admin": "npm --prefix frontend/admin run build",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "db:seed:demo": "npm --prefix backend run db:seed:demo",
    "db:import:barilga": "npm --prefix backend run db:import:barilga --",
    "db:studio": "npm --prefix backend run db:studio",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply"
  },
  "devDependencies": {
    "railway": "^3.11.0"
  }
}
