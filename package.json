  "private": true,
  "description": "100 Айл — барилгын материалын e-commerce платформ (modular monolith)",
  "scripts": {
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:storefront": "npm --prefix apps/storefront run dev",
